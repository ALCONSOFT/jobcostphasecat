<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="0">
        <!-- Add purchase request applications to base groups -->
        <!-- Usuario o Captador de SdC -->
        <record id="ethics_purchase_request.group_request_user" model="res.groups">
            <field name="name">Usuari@</field>
            <field name="category_id" ref="ethics_purchase_request.module_category_request"/>
            <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>
        </record>
        <!-- Verificador -->
        <record id="ethics_purchase_request.group_request_verifier" model="res.groups">
            <field name="name">Verificad@r</field>
            <field name="category_id" ref="ethics_purchase_request.module_category_request"/>
            <field name="implied_ids" eval="[(4, ref('ethics_purchase_request.group_request_user'))]"/>
        </record>
        <!-- Auditor-->
        <record id="group_request_auditor" model="res.groups">
            <field name="name">Auditor@</field>
            <field name="category_id" ref="ethics_purchase_request.module_category_request"/>
            <field name="implied_ids" eval="[(4, ref('ethics_purchase_request.group_request_verifier'))]"/>
        </record>
        <!-- Comprador-->
        <record id="group_request_buyer" model="res.groups">
            <field name="name">Comprador@</field>
            <field name="category_id" ref="ethics_purchase_request.module_category_request"/>
            <field name="implied_ids" eval="[(4, ref('jobcostphasecat.group_request_auditor'))]"/>
        </record>
        <!-- Aprobador-->
        <record id="ethics_purchase_request.group_request_approver" model="res.groups">
            <field name="name">Aprobad@r</field>
            <field name="category_id" ref="ethics_purchase_request.module_category_request"/>
            <field name="implied_ids" eval="[(4, ref('jobcostphasecat.group_request_buyer'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
        <!-- ***********************************************-->
        <!-- Categorias de Aprobación de Compras por Almacén-->
        <!-- ***********************************************-->        
        <record model="ir.module.category" id="module_category_rfq">
            <field name="name">RfQ - SdP - Aprobaciónde Solicitud de Presupuestos</field>
        </record>
        <!-- Usuario o Enviador de correos-->
        <record id="group_rfq_user" model="res.groups">
            <field name="name">1.Usuari@</field>
            <field name="category_id" ref="module_category_rfq"/>
        </record>
        <!-- Actualizador de Precios-->
        <record id="group_rfq_updater" model="res.groups">
            <field name="name">2.Actualizador@</field>
            <field name="category_id" ref="module_category_rfq"/>
        </record>
        <!-- Revisor de Precios-->
        <record id="group_rfq_reviewer" model="res.groups">
            <field name="name">3.Revisor@</field>
            <field name="category_id" ref="module_category_rfq"/>
        </record>
        <!-- Aprobador de Precios-->
        <record id="group_rfq_price_approver" model="res.groups">
            <field name="name">4.Aprobador@ de Precios</field>
            <field name="category_id" ref="module_category_rfq"/>
        </record>
        <!-- Aprobador de SdP-->
        <record id="group_rfq_approver" model="res.groups">
            <field name="name">5.Aprobador@ de SdP</field>
            <field name="category_id" ref="module_category_rfq"/>
        </record>
        <!-- Confirmador de SdP-->
        <record id="group_rfq_confirn" model="res.groups">
            <field name="name">6.Confirmador@</field>
            <field name="category_id" ref="module_category_rfq"/>
        </record>
        <!-- Enviador de P.O.-->
        <record id="group_rfq_sender_po" model="res.groups">
            <field name="name">7.Enviador@ de P.O.</field>
            <field name="category_id" ref="module_category_rfq"/>
        </record>
        <!--Usaurio Adjuntador-->
        <record id="group_attachment_user" model="res.groups">
            <field name="name">Attachment User</field>
            <field name="category_id" ref="base.module_category_hidden"/>
        </record> 
        <!-- ***********************************************-->
    <!--================================================================-->
    <!--  Grupo para permitir “Doble Transferencia Interna”              -->
    <!--================================================================-->
        <record id="group_double_internal_transfer" model="res.groups">
            <!-- Este será el nombre que veremos en Ajustes → Usuarios & Compañías → Grupos -->
            <field name="name">Double Internal Transfer</field>

            <!-- Es buena práctica encuadrar el grupo dentro de una categoría.
                Aquí lo anidamos debajo de “Administración de Compras” -->
            <field name="category_id" ref="purchase.group_purchase_manager"/>

            <!-- (Opcional) Puedes asignar otras propiedades, 
                pero para un grupo básico basta con name+category. -->
        </record>    
    </data>
</odoo>
