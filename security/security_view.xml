<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="0">
        <!-- Add purchase request applications to base groups -->
        <!-- Usuario o Captador de SdC -->
        <record id="ethics_purchase_request.group_request_user" model="res.groups">
            <field name="name">Usuari@</field>
            <field name="category_id" ref="ethics_purchase_request.module_category_request"/>
            <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>
        </record>
        <!-- Verificador -->
        <record id="ethics_purchase_request.group_request_verifier" model="res.groups">
            <field name="name">Verificad@r</field>
            <field name="category_id" ref="ethics_purchase_request.module_category_request"/>
            <field name="implied_ids" eval="[(4, ref('ethics_purchase_request.group_request_user'))]"/>
        </record>
        <!-- Auditor-->
        <record id="group_request_auditor" model="res.groups">
            <field name="name">Auditor@</field>
            <field name="category_id" ref="ethics_purchase_request.module_category_request"/>
            <field name="implied_ids" eval="[(4, ref('ethics_purchase_request.group_request_verifier'))]"/>
        </record>
        <!-- Comprador-->
        <record id="group_request_buyer" model="res.groups">
            <field name="name">Comprador@</field>
            <field name="category_id" ref="ethics_purchase_request.module_category_request"/>
            <field name="implied_ids" eval="[(4, ref('jobcostphasecat.group_request_auditor'))]"/>
        </record>
        <!-- Aprobador-->
        <record id="ethics_purchase_request.group_request_approver" model="res.groups">
            <field name="name">Aprobad@r</field>
            <field name="category_id" ref="ethics_purchase_request.module_category_request"/>
            <field name="implied_ids" eval="[(4, ref('jobcostphasecat.group_request_buyer'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

    </data>
</odoo>
