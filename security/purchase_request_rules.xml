<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="rule_purchase_request_exclude_user_warehouses" model="ir.rule">
        <field name="name">Restringir solicitudes por almacenes no permitidos</field>
        <field name="model_id" ref="model_purchase_request"/>
        <field name="domain_force">[('warehouse_id', 'not in', user.warehouse_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record> 

    <record id="rule_purchase_order_exclude_user_warehouses" model="ir.rule">
        <field name="name">Restringir SdP y O.C. por almacenes no permitidos</field>
        <field name="model_id" ref="model_purchase_order"/>
        <field name="domain_force">[('picking_type_id.warehouse_id', 'not in', user.warehouse_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record> 

</odoo>
