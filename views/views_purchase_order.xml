<odoo>
    <data>
        <!-- Heredar la vista tree de purchase.order sdp-->
        <record id="purchase_order_inherit_purchase_order_tree" model="ir.ui.view">
            <field name="name">purchase.order.inherit.purchase.order.tree</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
            <field name="arch" type="xml">
                <!-- Insertar los campos después del campo 'invoice_status' -->
                <xpath expr="//field[@name='invoice_status']" position="after">
                    <field name="vehicle_id" optional="show"/>
                    <field name="account_analytic_id" optional="show"/>
                    <field name="pr_ref_id" optional="show"/>
                    <field name="payment_term_id" optional="show"/>
                </xpath>
                <xpath expr="//field[@name='user_id']" position="attributes">
                    <attribute name="string">Usuario</attribute>
                </xpath>
                <!-- Agregando colores a los estados agregados
                                        <field name="state" optional="show" widget="badge" decoration-success="state == 'purchase' or state == 'done'" decoration-warning="state == 'to approve'" decoration-info="state == 'draft' or state == 'sent'"/>-->
                <xpath expr="//field[@name='state']" position="replace">
                    <field name="state" optional="show" widget="badge"
                            decoration-success="state == 'purchase' or state == 'done'"
                            decoration-warning="state == 'to approve'"
                            decoration-info="state == 'draft' or state == 'sent'"
                            decoration-danger="state == 'waiting_for_price_revision' or 
                                state == 'waiting_for_price_approval' or
                                state == 'waiting_for_approval' "
                            decoration-it="state == 'waiting_for_price_revision' or 
                                state == 'waiting_for_price_approval'"
                            decoration-bf="state == 'waiting_for_approval'" />
                </xpath>
            </field>
        </record>
        <!-- Heredar la vista tree de purchase.order po-->
        <record id="purchase_order_inherit_purchase_order_tree_jc" model="ir.ui.view">
            <field name="name">purchase.order.inherit.purchase.order.tree</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
            <field name="arch" type="xml">
                <!-- Insertar los campos después del campo 'invoice_status' -->
                <xpath expr="//field[@name='invoice_status']" position="after">
                    <field name="vehicle_id" optional="show"/>
                    <field name="account_analytic_id" optional="show"/>
                    <field name="payment_term_id" optional="show"/>
                </xpath>
            </field>
        </record>
        <!-- Heredar la vista form de purchase.order.form-->
        <record id="purchase_order_form_custom_fields" model="ir.ui.view">
            <field name="name">purchase.order.form.custom.fields</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='currency_id']" position="after">
                    <field name="invoice_status"/>
                </xpath>
                <!-- Insertamos el botón dentro del árbol de las líneas: 2025.02.26 -->
                <xpath expr="//field[@name='order_line']/tree" position="inside">
                    <button name="action_view_line_history"
                            type="object"
                            icon="fa-history"
                            string="Historial" />
                </xpath>

                <!-- Insertar campos después del campo 'effective_date' -->
                <xpath expr="//field[@name='effective_date']" position="after">
                    <field name="account_analytic_id"/>
                    <field name="vehicle_id"/>
                    <field name="payment_term_id"/>
                    <field name="send_all_attachments" />
                </xpath>
                <!-- Agregar campo computado para subtotal-->
                <field name="tax_totals" position="before">
                        <field name="total_price_subtotal" readonly="1"/>
                </field>
                <xpath expr="//field[@name='order_line']/tree" position="inside">
                    <field name="product_qty" string="Qty" class="text-right"
                        options="{'no_create': True}"
                        widget="float"
                        attrs="{'readonly': [('state', 'not in', ['draft', 'sent', 'waiting_for_price_revision'])]}"
                        decoration-danger="hide == True" />
                </xpath>
                <xpath expr="//field[@name='price_tax']" position="after">
                    <field name="vehicle_id" optional="show" decoration-danger="hide == True"/>
                    <field name="account_analytic_id" optional="show" decoration-danger="hide == True"/>
                    <field name="notes" optional="show" decoration-danger="hide == True"/>
                    <field name="allow_qty_change_line" optional="hide" />
                    <field name="hide" optional="show" class="text-primary" decoration-danger="hide == True"/>
                    <field name="phase_id" optional="show"/>
                </xpath>
                <xpath expr="//field[@name='product_id']" position="attributes">
                    <attribute name="decoration-danger">hide == True</attribute>
                </xpath>
                <xpath expr="//field[@name='price_unit']" position="attributes">
                    <attribute name="decoration-danger">hide == True</attribute>
                </xpath>
                <xpath expr="//field[@name='taxes_id']" position="attributes">
                    <attribute name="decoration-danger">hide == True</attribute>
                </xpath>
                <xpath expr="//field[@name='price_subtotal']" position="attributes">
                    <attribute name="decoration-danger">hide == True</attribute>
                </xpath>
                <xpath expr="//field[@name='product_uom']" position="attributes">
                    <attribute name="decoration-danger">hide == True</attribute>
                </xpath>

                <!--Agregando historia de productos: 2025.02.26-->
                <xpath expr="//notebook" position="inside">
                    <page string="Historial de Compras">
                        <field name="purchase_history_ids" readonly="1">
                            <tree>
                                <field name="order_id" invisible="1"/>
                                <field name="product_id"/>
                                <field name="product_qty"/>
                                <field name="price_unit"/>
                                <field name="date_planned"/>
                                <field name="partner_id" string="Proveedor" />
                                <!-- Agrega más campos que quieras ver, por ejemplo el estado de la orden -->
                                <field name="state" />
                            </tree>
                            <form>
                                <sheet>
                                    <group>
                                        <field name="product_id"/>
                                        <field name="product_qty"/>
                                        <field name="price_unit"/>
                                        <field name="date_planned"/>
                                    </group>
                                </sheet>
                            </form>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
        <!-- views/purchase_order_line_history.xml -->
        <record id="view_purchase_order_line_form_inherit_history" model="ir.ui.view">
            <field name="name">purchase.order.line.form.inherit.history</field>
            <field name="model">purchase.order.line</field>
            <field name="inherit_id" ref="purchase.purchase_order_line_form2"/> 
            <!-- Ajusta el ref al XML que define el formulario de la línea -->
            <field name="arch" type="xml">
                <!-- Donde quieras insertarlo; por ejemplo dentro de <sheet> -->
                <xpath expr="//sheet" position="inside">
                    <notebook>
                        <page string="Historial de esta línea">
                            <field name="line_history_ids" readonly="1">
                                <tree>
                                    <field name="order_id"/>
                                    <field name="product_id"/>
                                    <field name="product_qty"/>
                                    <field name="price_unit"/>
                                    <field name="date_planned"/>
                                    <field name="state"/>
                                </tree>
                                <form>
                                    <sheet>
                                        <group>
                                            <field name="order_id"/>
                                            <field name="product_id"/>
                                            <field name="product_qty"/>
                                            <field name="price_unit"/>
                                            <field name="date_planned"/>
                                            <field name="state"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </xpath>
            </field>
        </record>
        <!-- Heredar la vista con ID externo 'purchase.purchase_history_tree': 2025.02.26 -->
        <record id="purchase_purchase_history_tree_inherit" model="ir.ui.view">
            <field name="name">purchase.history.tree.inherit</field>
            <field name="model">purchase.order.line</field>
            <!-- Reemplaza con el ID exacto de la vista que quieres heredar -->
            <field name="inherit_id" ref="purchase.purchase_history_tree"/>
            <field name="arch" type="xml">
                <!-- Insertar campos dentro del tree existente -->
                <xpath expr="//tree" position="inside">
                    <!-- Fecha de la OC (si el modelo base es purchase.order.line y la fecha vive en order_id) -->
                    <field name="date_order" string="Fecha OC"/>

                    <!-- Estado de la Orden (purchase, done, cancel, etc.) -->
                    <field name="state" string="Estatus"/>

                    <!-- Campo pr_ref_ids (ajusta el string si deseas) -->
                    <field name="pr_ref_ids" string="PR Ref IDs" widget="Many2one"/>
                </xpath>
            </field>
        </record>
        <!-- Heredar la vista form de purchase_discount.purchase.order.form -->
        <record id="purchase_order_form_discounted_price" model="ir.ui.view">
            <field name="name">purchase.order.form.discounted.price</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase_discount.purchase_order_form"/>
            <field name="arch" type="xml">
                <!-- Insertar campo después del campo 'price_unit' -->
                <xpath expr="//field[@name='price_unit']" position="after">
                    <field name="price_unit_discounted" string="P.U.Desc."
                        decoration-danger="hide == True" readonly="1"/>
                </xpath>
            </field>
        </record>
        <!-- Copyright 2025 - jobcostphasecat
        Heredar la vista form de purchase.order.form del módulo purchase_order_general_discount
        License AGPL-3.0 or later (https://www.gnu.org/licenses/agpl). -->
        <record id="purchase_order_form_inherit_jobcostphasecat" model="ir.ui.view">
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase_order_general_discount.purchase_order_form" />
            <field name="arch" type="xml">
            <!-- Protegemos el botón y el campo general_discount -->
            <xpath expr="//button[@name='action_update_general_discount']" position="attributes">
                <attribute name="attrs">{'invisible': [('state', 'not in', ['draft', 'send', 'waiting_for_price_revision'])]}</attribute>
            </xpath>
            <xpath expr="//field[@name='general_discount']" position="attributes">
                <attribute name="attrs">{'readonly': [('state', 'not in', ['draft', 'send', 'waiting_for_price_revision'])]}</attribute>
            </xpath>
            </field>
        </record>
        <!-- Heredar la vista form de purchase.order.form -->
        <record id="purchase_order_form_approval_rules_jc" model="ir.ui.view">
            <field name="name">purchase.order.form.approval.rules.jc</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <!-- Cambiar los atributos del boton: action_rfq_send
                    <attribute name='attrs'>{'invisible': ['|', ('state','!=','draft'), ('purchase_order_approval_rule_ids', '!=', [])]} -->
                <xpath expr="//button[@name='action_rfq_send']" position="replace">
                    <button name="action_rfq_send"
                        states="draft"
                        string="1.Enviar SdP e-mail"
                        type="object" context="{'send_rfq':True}"
                        class="oe_highlight" data-hotkey="g"
                        groups="jobcostphasecat.group_rfq_user"/>
                    <button name="action_rfq_send_jc"
                        states="purchase"
                        string="7.Bloquear - Enviado P.O. e-mail"
                        type="object" context="{'send_rfq':False}"
                        class="btn-primary oe_highlight" data-hotkey="g"
                        groups="jobcostphasecat.group_rfq_sender_po"/>
                    <button name="action_back"
                        string="Regresar"
                        type="object"
                        class="btn-secondary"
                        groups="jobcostphasecat.group_rfq_user"
                        attrs="{'invisible': [('state', 'in', ['done','purchase','draft'])]}"/>
                </xpath>

                <!-- Eliminar el botón de confirmación -->
                <xpath expr="//button[@name='button_confirm']" position="attributes">
                    <attribute name="attrs">{'invisible': [('state', '!=', 'done-plus')]}</attribute>
                </xpath>
                <!-- Insertar boton: Envio para Revisión de Precio-->
                <xpath expr="//button[@name='button_confirm']" position="before">
                    <button name="action_waiting_for_price_revision"
                        string="2.Envío a Revisión de Precios" type="object"
                        class="btn-primary oe_highlight"
                        groups="jobcostphasecat.group_rfq_updater"
                        attrs="{'invisible': [('state', '!=', 'sent') ] }"
                    />
                    <button name="action_discard"
                        string="Descartar"
                        type="object"
                        class="btn-secondary"
                        groups="jobcostphasecat.group_rfq_approver"
                        attrs="{'invisible': [('state', '!=', 'to approve')]}"
                    />
                </xpath>
                <!-- Insertar boton: Envio para Aprobación de Precio-->
                <xpath expr="//button[@name='button_confirm']" position="before">
                    <button name="action_waiting_for_price_approval"
                        string="3.Envío a Aprobación de Precios" type="object"
                        class="btn-primary oe_highlight"
                        groups="jobcostphasecat.group_rfq_reviewer"
                        attrs="{'invisible': [('state', '!=', 'waiting_for_price_revision') ] }"
                    />
                    <button name="reject_waiting_for_price_revision"
                        string="Rechazo en Revisión de Precios" type="object"
                        groups="jobcostphasecat.group_rfq_reviewer"
                        attrs="{'invisible': [('state', '!=', 'waiting_for_price_revision') ] }"
                    />
                </xpath>
                <!-- Insertar boton: Envio para Aprobación de SdP -->
                <xpath expr="//button[@name='button_confirm']" position="before">
                    <button name="action_waiting_for_approval"
                        string="4.Envío a Aprobación de SdP" type="object"
                        class="btn-primary oe_highlight"
                        groups="jobcostphasecat.group_rfq_price_approver"
                        attrs="{'invisible': [('state', '!=', 'waiting_for_price_approval') ] }"
                    />
                    <button name="reject_waiting_for_price_approval"
                        string="Rechazo en Aprobación de Precios" type="object"
                        class="oe_buttom"
                        groups="jobcostphasecat.group_rfq_price_approver"
                        attrs="{'invisible': [('state', '!=', 'waiting_for_price_approval') ] }"
                    />
                </xpath>

                <!-- Insertar boton: Rechazar Aprobación de SdP y Envio a Aprobacion de Compras
                        Este botón debe estar solo lectura hasta que se haya aprobado todas
                        las reglas de aprobacion-->
                <xpath expr="//button[@name='button_confirm']" position="before">
                    <button name="action_send_to_approve_purchase"
                        string="5.Envío a Aprob.@Compras" type="object"
                        class="btn-primary oe_highlight"
                        groups="jobcostphasecat.group_rfq_approver"
                        attrs="{'invisible': [('state', '!=', 'waiting_for_approval')]}"
                    />
                    <button name="reject_waiting_for_approval"
                        string="Rechazo de Aprobación de SdP" type="object"
                        groups="jobcostphasecat.group_rfq_approver"
                        attrs="{'invisible': [('state', '!=', 'waiting_for_approval') ] }"
                    />
                </xpath>
                <!-- Cambio de atributos del botón: action_button_approve. 
                <xpath expr="//button[@name='button_confirm']" position="before">
                    <button name="action_buttom_approve_jc"
                        string="Aprobar SdP" type="object"
                        groups="jobcostphasecat.group_rfq_approver"
                        attrs="{'invisible': [('state', '!=', 'waiting_for_approval') ] }"
                    />
                </xpath>
                -->
                <!-- Botón Enviar P.O.-->
                <xpath expr="//button[@name='action_rfq_send']" position="before">
                </xpath>
                <!-- Cambiar los atributos del boton: button_approve -->
                <xpath expr="//button[@name='button_approve']" position="attributes">
                    <attribute name="string">6.Confirmar</attribute>
                    <attribute name='attrs'>{'invisible': [('state','!=','to approve') ]} </attribute>
                    <attribute name="groups">jobcostphasecat.group_rfq_confirn</attribute>
                </xpath>
            </field>
        </record>
        <!-- Heredar las busquedas de purchase.order-->
        <record id="purchase_order_pr_ref_id_filter" model="ir.ui.view">
            <field name="name">purchase.order.pr.ref.id.filter</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//search" position="inside">
                    <!--
                    <filter string="PR Reference ID" name="filter_pr_ref_id" domain="[('pr_ref_id', 'ilike', self)]"/>
                    -->
                    <field name="pr_ref_id" />
                </xpath>
            </field>
        </record>
    </data>
</odoo>
