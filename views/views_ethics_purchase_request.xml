<odoo>
    <!---->    
    
    <!-- Si también necesitas heredar la vista tree -->
    <record id="view_purchase_request_tree_inherit_jobcostphasecat" model="ir.ui.view">
        <field name="name">purchase.request.tree.inherit.jobcostphasecat</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="ethics_purchase_request.view_purchase_request"/>
        <field name="arch" type="xml">
        
            <xpath expr="//tree" position="inside">
                <!-- Añade aquí campos adicionales si es necesario, ejemplo: -->
                <field name="vehicle_id" optional="show"/>
                <field name="account_analytic_id" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='priority']" position="after">
                <field name="sequence_alter"/>
                <!--2025.04.05-->
                <field name="current_user_id" optional="hide"/>
                <field name="unauthorized_warehouses" optional="hide"/>
            </xpath>

           <xpath expr="//field[@name='state']" position="replace">
                <field name="state"
                    string="Estatus"
                    widget="badge"
                    decoration-info="state in ['draft']"
                    decoration-success="state in ['confirm']"
                    decoration-warning="state in ['waiting_for_verifier', 'waiting_for_audit']"
                    decoration-danger="state in ['waiting_for_buyer', 'waiting_for_approver']"
                    decoration-muted="state in ['cancel']"
                    decoration-it="state in ['waiting_for_buyer', 'waiting_for_verifier']" />
            </xpath>
                           
            <xpath expr="//field[@name='employee_id']" position="replace">
                <field name="employee_id"
                    widget="many2one_avatar_user" />
            </xpath>


        </field>
    </record>
    <!-- NUeva vista arbol de Solicitud ede compras  domain="[('warehouse_id', 'not in', current_user_id.warehouse_ids.ids)]"-->
    <record id="view_purchase_request_tree_main" model="ir.ui.view">
        <field name="name">purchase.request.tree</field>
        <field name="model">purchase.request</field>
        <field name="arch" type="xml">
            <tree string="Solicitud de Compra">
                <field name="name"/>
                <field name="employee_id" widget="many2one_avatar_user"/>
                <field name="department_id"/>
                <field name="request_responsible"/>
                <field name="request_date"/>
                <field name="company_id"/>
                <field name="source_document"/>
                <field name="purchase_ids" widget="many2many_tags"/>
                <field name="state" widget="badge"
                    decoration-info="state in ['draft']"
                    decoration-success="state in ['confirm']"
                    decoration-warning="state in ['waiting_for_verifier', 'waiting_for_audit']"
                    decoration-danger="state in ['waiting_for_buyer', 'waiting_for_approver']"
                    decoration-muted="state in ['cancel']"/>
                <field name="priority"/>
                <field name="warehouse_id"/>
                <field name="unauthorized_warehouses" optional="hide" widget="many2many_tags" modifiers="{&quot;readonly&quot;: true}"/>
                <field name="mostrar_a_usuario" optional="hide" modifiers="{&quot;readonly&quot;: true}"/>
            </tree>
        </field>
    </record>
    <record id="action_purchase_request_tree_main" model="ir.actions.act_window">
        <field name="name">Solicitudes de Compra</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">purchase.request</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('mostrar_a_usuario', '=', True)]</field>
        <field name="view_id" ref="view_purchase_request_tree_main"/>
    </record>
    <menuitem id="menu_purchase_request_main"
        name="Solicitudes de Compra"
        parent="purchase.menu_purchase_root"
        action="action_purchase_request_tree_main"
        sequence="20"/>
<!--
-->
    <record id="view_purchase_request_form_inherit_jobcostphasecat" model="ir.ui.view">
        <field name="name">purchase.request.form.inherit.jobcostphasecat</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="ethics_purchase_request.view_purchase_request_form"/>
        <field name="arch" type="xml">
            <field name="request_responsible" position="after">
                <field name="picking_type_id" string="Entregar a Almacén:" domain="[('code', '=', 'incoming')]"/>
                <field name="vehicle_id" optional="show"/>
                <field name="account_analytic_id" optional="show"/>
            </field>
            <xpath expr="//field[@name='vendor_ids']" position="after">
                <field name="vehicle_id" domain="[]" optional="show"/>
                <field name="phase_id" domain="[]" optional="show"/>
            </xpath>
           
            <!-- Botón para generar el reporte QWeb -->
            <xpath expr="//header" position="inside">
                <button name="%(jobcostphasecat.action_report_purchase_request)d" string="Imprimir Solicitud de Compra" type="action" class="btn-primary"/>
                <button name="action_open_vehicle_selection" string="Listar Vehículos" type="object" class="btn-secondary"/>                
            </xpath>
            <!-- Reemplazamos el botón original con uno nuevo -->
            <xpath expr="//button[@name='action_confirm']" position="replace">
                <button name="action_confirm_ethics"
                        string="Aprobar SdC" class="btn-primary" type="object"
                        attrs="{'invisible': [('state', '!=', 'waiting_for_approver')]}"
                        groups="ethics_purchase_request.group_request_approver"/>
                <button name="reject_approver_pr"
                        string="Rechazar SdC" type="object" class='oe_highlight'
                        attrs="{'invisible': [('state', '!=', 'waiting_for_approver')]}"
                        groups="jobcostphasecat.group_request_approver"/>                        
            </xpath>
            <!-- Insertar modificaciones después del campo priority -->
            <xpath expr="//field[@name='priority']" position="after">
                <!-- Aquí añades el nuevo campo o la modificación deseada. 
                        Por ejemplo, añadir un campo llamado 'sequence_alter'. -->
                <field name="sequence_alter"/>
                <field name="payment_term_id" optional="hide"/>
            </xpath>

            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="statusbar_visible">draft,
                        waiting_for_verifier,
                        waiting_for_audit,
                        waiting_for_buyer,
                        waiting_for_approver,
                        confirm,
                        cancel</attribute>
            </xpath>
            <!-- Usuario envia a Verificador-->
            <xpath expr="//button[@name='action_submit_for_verifier']" position="replace">
                <button name="action_submit_for_verifier_jc"
                        string="Enviar a Verificar" class="btn-primary" type="object"
                        attrs="{'invisible': [('state', '!=', 'draft')]}"
                        groups="ethics_purchase_request.group_request_user"/>
            </xpath>
            <xpath expr="//button[@name='reject_verifier_pr']" position="replace">            
                <button name="reject_verifier_pr_jc"
                        string="Rechazar" type="object" class='oe_highlight'
                        attrs="{'invisible': [('state', '!=', 'waiting_for_verifier')]}"
                        groups="ethics_purchase_request.group_request_user"/>
                <button name="reject_verifier_pr_jc"
                        string="Enviar a Borrador" type="object" class='oe_highlight'
                        attrs="{'invisible': [('state', '=', 'confirm')]}"
                        groups="ethics_purchase_request.group_request_user"/>
            </xpath>

            <!-- Verificador envia a Auditor-->
            <xpath expr="//button[@name='action_submit_for_approver']" position="before">
                <button name="action_waiting_for_audit"
                        string="Enviar a Auditoría" class="btn-primary" type="object"
                        attrs="{'invisible': [('state', '!=', 'waiting_for_verifier')]}"
                        groups="ethics_purchase_request.group_request_verifier"/>
            </xpath>
            <!-- Auditor envia al comprador -->
            <xpath expr="//button[@name='action_submit_for_approver']" position="before">
                <button name="action_submit_for_audit"
                        string="Enviar a Compras" class="btn-primary" type="object"
                        attrs="{'invisible': [('state', '!=', 'waiting_for_audit')]}"
                        groups="jobcostphasecat.group_request_auditor"
                        />
                <button name="reject_audit_pr"
                        string="Rechazar por Auditoría" class="btn-primary" type="object"
                        attrs="{'invisible': [('state', '!=', 'waiting_for_audit')]}"
                        groups="jobcostphasecat.group_request_auditor"/>
            </xpath>
            <!-- Comprador envia al gerente -->
            <xpath expr="//button[@name='action_submit_for_approver']" position="replace">
                <button name="action_submit_for_approver"
                        string="Enviar a Aprobación" class="btn-primary" type="object"
                        attrs="{'invisible': [('state', '!=', 'waiting_for_buyer')]}"
                        groups="jobcostphasecat.group_request_buyer"/>
            </xpath>
            <xpath expr="//button[@name='reject_approver_pr']" position="replace">
                <button name="reject_approver_pr"
                        string="Rechazar SdC" type="object" class='oe_highlight'
                        attrs="{'invisible': [('state', '!=', 'waiting_for_buyer')]}"
                        groups="jobcostphasecat.group_request_buyer"/>                        
            </xpath>
            <!-- Cambiar el campo vendor_ids; para que tambien el comprador pueda agregar los vendors-->
            <!-- Cambiar el campo vendor_ids; para que tambien el comprador pueda agregar los vendors-->
            <xpath expr="//field[@name='vendor_ids']" position="replace">
                <field name="vendor_ids"
                    widget="many2many_tags"
                    create="0"
                    can_create="false"
                    options="{'no_create': True, 'no_create_edit': True}"
                    attrs="{'column_invisible': [('parent.state', 'not in', ['waiting_for_approver','confirm','waiting_for_buyer'])]}"/>
            </xpath>

        </field>
    </record>

<record id="view_purchase_request_form_inherit_jobcostphasecat2" model="ir.ui.view">
    <field name="name">purchase.request.form.inherit</field>
    <field name="model">purchase.request</field>
    <field name="inherit_id" ref="ethics_purchase_request.view_purchase_request_form"/>
    <field name="arch" type="xml">

        <!-- Agregando campo state en la vista -->
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="statusbar_visible">draft,
                        waiting_for_verifier,
                        waiting_for_audit,
                        waiting_for_buyer,
                        waiting_for_approver,
                        confirm,
                        cancel</attribute>
            </xpath>

        <!-- Reemplazamos la pestaña "Request Lines" -->
        <xpath expr="//notebook/page[@name='request_lines']" position="replace">
            <page string="Products" name="products">
                <field name="pr_lines" widget="section_and_note_one2many" mode="tree,kanban"
                    context="{'default_state': 'draft'}"
                    attrs="{'readonly': [('state', 'in', ('confirm', 'cancel'))]}">
                    
                    <tree string="Purchase Request Lines" editable="bottom">
                        <control>
                            <create name="add_product_control" string="Add a product"/>
                            <create name="add_section_control" string="Add a section" context="{'default_display_type': 'line_section'}"/>
                            <create name="add_note_control" string="Add a note" context="{'default_display_type': 'line_note'}"/>
                        </control>
                        
                        <field name="display_type" invisible="1"/>
                        <field name="sequence" widget="handle"/>
                        <field name="state" invisible="1"/>
                        <field name="product_id" 
                               attrs="{'readonly': [('state', 'not in', ('draft'))], 'required': [('display_type', '=', False)]}"
                               domain="[('purchase_ok', '=', True), '|', ('company_id', '=', False), ('company_id', '=', parent.company_id)]"/>
                        <field name="name" widget="section_and_note_text"/>
                        <field name="product_qty"/>
                        <field name="product_uom"/>
                        <field name="vendor_ids" widget="many2many_tags" 
                               attrs="{'column_invisible': [('parent.state', 'not in', ['waiting_for_approver','confirm','waiting_for_buyer'])]}"/>
                        <field name="price_unit" optional="hide"/>
                        <field name="price_subtotal" optional="hide" widget="monetary"/>
                        <field name="account_analytic_id" optional="show"/>
                        <field name="vehicle_id"/>
                        <field name="phase_id" optional="show"/>
                    </tree>

                    <form string="Purchase Request Line">
                        <field name="display_type" invisible="1"/>
                        
                        <group attrs="{'invisible': [('display_type', '!=', False)]}">
                            <group>
                                <field name="product_id" widget="many2one_barcode"
                                       domain="[('purchase_ok', '=', True), '|', ('company_id', '=', False), ('company_id', '=', parent.company_id)]"/>
                                <field name="product_qty"/>
                                <field name="product_uom"/>
                                <field name="price_unit"/>
                            </group>
                        </group>

                        <!-- NUEVO: Permitimos editar `vendor_ids` en las secciones y notas -->
                        <group attrs="{'invisible': [('display_type', '=', False)]}">
                            <label for="name" string="Section Name (eg. Products, Services)" attrs="{'invisible': [('display_type', '!=', 'line_section')]}"/>
                            <label for="name" string="Note" attrs="{'invisible': [('display_type', '!=', 'line_note')]}"/>
                            
                            <field name="name" nolabel="1"/>
                            <field name="vendor_ids" widget="many2many_tags"/>
                        </group>
                    </form>

                    <kanban>
                        <field name="name"/>
                        <field name="product_id"/>
                        <field name="product_qty"/>
                        <field name="product_uom"/>
                        <field name="price_subtotal"/>
                        <field name="price_unit"/>
                        <field name="display_type"/>
                        <field name="vendor_ids"/>
                        <field name="account_analytic_id"/> 
                        <field name="vehicle_id"/>
                        <field name="phase_id"/>

                        <templates>
                            <t t-name="kanban-box">
                                <div t-attf-class="oe_kanban_card {{ record.display_type.raw_value ? 'o_is_' + record.display_type.raw_value : '' }}">
                                    <t t-if="!record.display_type.raw_value">
                                        <div class="row">
                                            <div class="col-8">
                                                <strong>
                                                    <span t-esc="record.product_id.value"/>
                                                </strong>
                                            </div>
                                            <div class="col-4 text-end">
                                                <strong>
                                                    <span t-esc="record.price_subtotal.value"/>
                                                </strong>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-12 text-muted">
                                                <span>
                                                    Quantity:
                                                    <t t-esc="record.product_qty.value"/>
                                                    <t t-esc="record.product_uom.value"/>
                                                </span>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-12 text-muted">
                                                <span>
                                                    Unit Price:
                                                    <t t-esc="record.price_unit.value"/>
                                                </span>
                                            </div>
                                        </div>
                                    </t>

                                    <!-- NUEVO: Mostramos `vendor_ids` en Secciones y Notas -->
                                    <div t-elif="record.display_type.raw_value === 'line_section' || record.display_type.raw_value === 'line_note'" class="row">
                                        <div class="col-8">
                                            <span t-esc="record.name.value"/>
                                        </div>
                                        <div class="col-4">
                                            <span t-esc="record.vendor_ids.value"/>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </templates>
                    </kanban>
                </field>
            </page>
        </xpath>

    </field>
</record>


    <record id="view_fleet_vehicle_data_list" model="ir.ui.view">
        <field name="name">fleet.vehicle.data.list</field>
        <field name="model">fleet.vehicle.data</field>
        <field name="arch" type="xml">
            <tree string="Fleet Vehicle Data">
                <field name="vehicle_id"/>
                <field name="name"/>
                <field name="license_plate"/>
            </tree>
        </field>
    </record>


    <record id="view_purchase_request_search_inherit_jcseqal" model="ir.ui.view">
        <field name="name">purchase.request.search.seqal</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="ethics_purchase_request.view_purchase_request_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <!-- Agregar filtro de búsqueda por el campo sequence_alter -->
                <field name="sequence_alter" string="Secuencia Alterna" />
            </xpath>
        </field>
    </record>

</odoo>