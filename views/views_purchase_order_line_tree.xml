<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_line_tree_jc" model="ir.ui.view">
        <field name="name">purchase.order.line.tree.jc</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.purchase_order_line_tree" />
        <field name="mode">primary</field>
        <field name="priority">17</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_id']" position="after">
                <field name="state" optional="hide" />
                <field name="account_analytic_id" optional="hide"/>
                <field name="analytic_distribution" widget="analytic_distribution" optional="hide"/>
                <field name="phase_id" optional="hide"/>
                <field name="vehicle_id" optional="hide"/>
            </xpath>
 
            <xpath expr="//field[@name='order_id']" position="attributes">
                <attribute name="widget">many2one</attribute>
            </xpath>
                
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="product_type" optional="hide" />
            </xpath>
            <xpath expr="//field[@name='product_qty']" position="after">
                <field name="qty_invoiced" optional="hide" />
                <field name="qty_to_invoice" optional="hide" />
                <field name="qty_received" optional="hide" />
                <field name="qty_received_manual" optional="hide" />
            </xpath>
            <xpath expr="//field[@name='price_subtotal']" position="after">
                <field name="taxes_id" widget="many2many_tags" optional="hide" />
                <field
                    name="price_tax"
                    widget="monetary"
                    optional="hide"
                    sum="Price Tax"
                />
                <field name="price_total" optional="hide" sum="Price Total" />
                <field name="x_is_incomplete" optional="hide" />
            </xpath>
            <xpath expr="//field[@name='price_subtotal']" position="attributes">
                <attribute name="sum">Price Subtotal</attribute>
            </xpath>
            <xpath expr="//field[@name='date_planned']" position="before">
                <field name="date_order" optional="show" widget="date" />
            </xpath>
            <xpath expr="//list" position="inside">
                <field name="product_packaging_id" optional="hide" />
            </xpath>
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='date_planned']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="/list" position="inside">
                <field
                    name="invoice_lines"
                    widget="many2many_tags"
                    groups="account.group_account_invoice"
                    optional="hide"
                />
            </xpath>
        </field>
    </record>

    <record id="purchase_order_line_tree_jc_filter" model="ir.ui.view">
        <field name="name">purchase.order.line.tree.jc.filter</field>
        <field name="model">purchase.order.line</field>
        <field name="arch" type="xml">
            <search>
                <filter 
                    name="incomplete_deliveries" 
                    string="Incompletas: Pedidos diferentes de Recibidos en O.C. y no Ocultos"
                    domain="[('state', 'in', ('done','purchase')), ('x_is_incomplete','=', True), ('hide','!=', True)]"/>
                <filter name="draft_orders" string="Borradores" domain="[('state','=','draft')]"/>
                <filter name="confirmed_orders" string="Confirmadas" domain="[('state','=','purchase')]"/>
                <filter name="cancelled_orders" string="Canceladas" domain="[('state','=','cancel')]"/>

                <separator/>
                <filter name="group_by_supplier" string="Proveedor" context="{'group_by': 'partner_id'}"/>
                <filter name="group_by_order" string="Orden de Compra" context="{'group_by': 'order_id'}"/>
                <filter name="group_by_state" string="Estado" context="{'group_by': 'state'}"/>
                <filter name="group_by_date" string="Fecha Orden" context="{'group_by': 'date_order:month'}"/>
            </search>
        </field>
    </record>

    <record id="action_purchase_order_line_tree_jc" model="ir.actions.act_window">
        <field name="name">Líneas de SdP Ampliada</field>
        <field name="res_model">purchase.order.line</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="purchase_order_line_tree_jc"/>
        <field name="search_view_id" ref="purchase_order_line_tree_jc_filter"/>
    </record>

    <menuitem
        id="menu_purchase_order_line_tree_jc"
        name="Líneas de SdP Ampliada"
        action="action_purchase_order_line_tree_jc"
        parent="purchase.menu_procurement_management"
        sequence="7"/>

</odoo>