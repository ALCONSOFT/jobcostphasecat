<odoo>
    <!-- Heredamos la vista existente del formulario de stock.warehouse -->
    <record id="view_warehouse_inherit_analytic_account" model="ir.ui.view">
        <field name="name">stock.warehouse.form.inherit.analytic.account</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <!-- Añadimos una nueva pestaña al notebook -->
                <page string="Cuenta Analítica" name="analytic_account">
                    <group>
                        <field name="account_analytic_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- También puedes extender la vista de árbol si es necesario 
    <record id="view_warehouse_tree_inherit_analytic_account" model="ir.ui.view">
        <field name="name">stock.warehouse.tree.inherit.analytic.account</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="view_warehouse_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="account_analytic_id"/>
            </xpath>
        </field>
    </record>
    -->
</odoo>
