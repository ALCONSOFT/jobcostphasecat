<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="res_config_settings_view_form_inherit_jobcostphasecat" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.inherit.jobcostphasecat</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
    <field name="arch" type="xml">
      <xpath expr="//div[@data-key='purchase']" position="inside">
        <!-- Grupo de configuración Job Cost Phase Category -->
        <div class="o_setting_group">
          <h2>Job Cost Phase Category</h2>
          <div class="row mt16 o_settings_container">
            <!-- Permitir cambio de cantidades -->
            <div class="col-12 col-lg-6 o_setting_box">
              <div class="o_setting_left_pane">
                <field name="allow_qty_change"/>
              </div>
              <div class="o_setting_right_pane">
                <label for="allow_qty_change"/>
                <div class="text-muted">
                  Permitir modificar cantidades en las Solicitudes de Presupuesto
                </div>
              </div>
            </div>
            <!-- Requerir fase en Solicitudes de Presupuesto -->
            <div class="col-12 col-lg-6 o_setting_box">
              <div class="o_setting_left_pane">
                <field name="require_phase_id"/>
              </div>
              <div class="o_setting_right_pane">
                <label for="require_phase_id"/>
                <div class="text-muted">
                  Requerir fase en las Solicitudes de Presupuesto
                </div>
              </div>
            </div>
            <!-- Requerir fase en Transferencias de Salida -->
            <div class="col-12 col-lg-6 o_setting_box">
              <div class="o_setting_left_pane">
                <field name="require_phase_id_out_transfer"/>
              </div>
              <div class="o_setting_right_pane">
                <label for="require_phase_id_out_transfer"/>
                <div class="text-muted">
                  Requerir fase en las Transferencias de Salida
                </div>
              </div>
            </div>
            <!-- Restringir cambio de tipo de operación -->
            <div class="col-12 col-lg-6 o_setting_box">
              <div class="o_setting_left_pane">
                <field name="restrict_picking_type_change"/>
              </div>
              <div class="o_setting_right_pane">
                <label for="restrict_picking_type_change"/>
                <div class="text-muted">
                  Restringir cambio de Tipo de Operación (Entregar a) en órdenes de compra.
                  Solo usuarios con el permiso "Cambiar Tipo de Operación en Compras" podrán modificarlo.
                </div>
              </div>
            </div>
            <!-- Permitir duplicar transferencias solo en plantilla -->
            <div class="col-12 col-lg-6 o_setting_box">
              <div class="o_setting_left_pane">
                <field name="allow_transfer_duplication"/>
              </div>
              <div class="o_setting_right_pane">
                <label for="allow_transfer_duplication"/>
                <div class="text-muted">
                  Permitir duplicar transferencias solo en estado "Plantilla"
                </div>
                <div class="executive-summary">
                <ul>
                    <li>
                    <strong>Objetivo principal:</strong><br/>
                    Controlar y personalizar la duplicación de transferencias de inventario (pickings) de tipo “salida”.
                    </li>
                    <li>
                    <strong>Configuración dinámica:</strong><br/>
                    Basada en el parámetro <code>purchase.allow_transfer_duplication</code>:
                    <ul>
                        <li>Si está desactivado, delega en la copia estándar de Odoo.</li>
                        <li>Si está activado, impone reglas adicionales.</li>
                    </ul>
                    </li>
                    <li>
                    <strong>Alcance limitado:</strong><br/>
                    Solo se aplica a transferencias de salida (<code>picking_type_id.code == 'outgoing'</code>).<br/>
                    Recepciones y transferencias internas usan la lógica por defecto.
                    </li>
                    <li>
                    <strong>Restricción de estado:</strong><br/>
                    Con la opción activa, solo se permite duplicar si la transferencia está en estado “Plantilla”.<br/>
                    Cualquier otro estado genera un error.
                    </li>
                    <li>
                    <strong>Limpieza de datos en la copia:</strong><br/>
                    Para duplicaciones válidas, se reinician campos clave (<code>export</code>, fechas, referencias de usuario, analítica, origen…) antes de llamar al método padre.
                    </li>
                    <li>
                    <strong>Registro de auditoría:</strong><br/>
                    Tras crear la copia, se elimina la cuenta analítica de las líneas y se añade una entrada en la bitácora para asegurar la trazabilidad.
                    </li>
                </ul>
                </div>

              </div>
            </div>
          </div>
        </div>
      </xpath>
    </field>
  </record>

  <!-- Vista de configuración para Control de Stock Negativo en Inventario -->
  <record id="res_config_settings_view_form_inherit_stock_negative" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.inherit.stock.negative</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//div[@data-key='stock']" position="inside">
        <!-- Grupo de Control de Stock Negativo -->
        <div class="o_setting_group">
          <h2>Control de Stock Negativo</h2>
          <div class="row mt16 o_settings_container">

            <!-- Toggle principal: Habilitar control -->
            <div class="col-12 col-lg-6 o_setting_box" id="negative_stock_control">
              <div class="o_setting_left_pane">
                <field name="enable_negative_stock_control"/>
              </div>
              <div class="o_setting_right_pane">
                <label for="enable_negative_stock_control"/>
                <div class="text-muted">
                  Controla las salidas de inventario cuando no hay existencias disponibles
                </div>
              </div>
            </div>

            <!-- Almacenes permitidos (visible solo si control habilitado) -->
            <div class="col-12 o_setting_box"
                 attrs="{'invisible': [('enable_negative_stock_control', '=', False)]}">
              <div class="o_setting_right_pane">
                <label for="allowed_negative_stock_warehouse_ids"
                       string="Almacenes con Stock Negativo Permitido"/>
                <div class="text-muted mb-3">
                  Selecciona los almacenes que PUEDEN tener stock negativo.
                  Las salidas en estos almacenes NO serán bloqueadas por falta de existencias.
                </div>
                <field name="allowed_negative_stock_warehouse_ids"
                       widget="many2many_tags"
                       placeholder="Seleccionar almacenes..."
                       options="{'no_create': True}"/>
              </div>
            </div>

            <!-- Usuarios autorizados (visible solo si control habilitado) -->
            <div class="col-12 o_setting_box"
                 attrs="{'invisible': [('enable_negative_stock_control', '=', False)]}">
              <div class="o_setting_right_pane">
                <label for="allowed_negative_stock_user_ids"
                       string="Usuarios Autorizados para Salidas sin Stock"/>
                <div class="text-muted mb-3">
                  Selecciona los usuarios que PUEDEN hacer salidas aunque no haya existencias.
                  Estos usuarios NO recibirán error de validación por stock insuficiente.
                </div>
                <field name="allowed_negative_stock_user_ids"
                       widget="many2many_tags"
                       placeholder="Seleccionar usuarios..."
                       options="{'no_create': True}"/>
              </div>
            </div>

          </div>
        </div>
      </xpath>
    </field>
  </record>

</odoo>
