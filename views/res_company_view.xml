<!-- views/res_company_view.xml -->
<odoo>
    <data>

        <!-- Heredar la vista del formulario de la compañía -->
        <record id="view_company_form_inherit_stock_account" model="ir.ui.view">
            <field name="name">res.company.form.inherit.stock.account</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <!-- Añadir una nueva pestaña al final del formulario -->
                <xpath expr="//notebook" position="inside">
                    <page string="Contabilidad de Inventario">
                        <group>
                            <field name="anglo_saxon_accounting"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
