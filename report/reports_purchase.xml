<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Pivot Inherit -->
        <record id="view_purchase_report_pivot_inherit" model="ir.ui.view">
            <field name="name">purchase.report.pivot.inherit</field>
            <field name="model">purchase.report</field>
            <!-- Reemplaza este ref con la vista pivot que quieras heredar, 
                por ejemplo "purchase.view_purchase_order_pivot" si es la que viene con purchase.
                Ajusta según la ID real. -->
            <field name="inherit_id" ref="purchase.view_purchase_order_pivot"/>
            <field name="arch" type="xml">
                <!-- Insertamos dentro del <pivot> -->
                <xpath expr="//pivot" position="replace">
                    <field name="analytic_account_id" type="row"/>
                    <field name="vehicle_id" type="row"/>
                    <field name="phase_id" type="row"/>
                    <field name="partner_id" string="Vendor" type="row"/>                    
                </xpath>
            </field>
        </record>
        <!-- Graph Inherit -->
        <record id="view_purchase_report_graph_inherit" model="ir.ui.view">
            <field name="name">purchase.report.graph.inherit</field>
            <field name="model">purchase.report</field>
            <field name="inherit_id" ref="purchase.view_purchase_order_graph"/>
            <field name="arch" type="xml">
                <xpath expr="//graph" position="inside">
                    <!-- Mostrar como opción de agrupación en eje X/Y -->
                    <field name="analytic_account_id"/>
                    <field name="vehicle_id"/>
                    <field name="phase_id"/>
                </xpath>
            </field>
        </record>

        <!-- Tree View -->
        <record id="view_purchase_report_tree_inherit" model="ir.ui.view">
            <field name="name">purchase.report.tree.inherit</field>
            <field name="model">purchase.report</field>
            <field name="inherit_id" ref="purchase.purchase_report_view_tree"/>
            <field name="arch" type="xml">
                <tree>
                    <field name="order_id" optional="show"/>
                    <field name="partner_id" optional="show"/>
                    <field name="product_id" optional="show"/>
                    <field name="category_id" optional="show"/>
                    <field name="user_id" optional="show" widget="many2one_avatar_user"/>
                    <field name="analytic_account_id" optional="show"/>
                    <field name="vehicle_id" optional="show"/>
                    <field name="phase_id" optional="show"/>
                </tree>
            </field>
        </record>
    <!-- Search View -->
    <record id="view_purchase_report_search_custom" model="ir.ui.view">
        <field name="name">purchase.report.search.custom</field>
        <field name="model">purchase.report</field>
        <field name="arch" type="xml">
            <search string="Purchase Analysis">
                <filter string="Requests for Quotation"
                    name="quotes"
                    domain="[('state','in',('draft','sent'))]"/>
                <filter string="Purchase Orders"
                    name="orders"
                    domain="[('state','in',('purchase','done'))]"/>
                <filter string="SdP Descartadas"
                    name="descarteds"
                    domain="[('state','=','descarted')]"/>
                <filter string="SdP Canceladas"
                    name="calcels"
                    domain="[('state','=','cancel')]"/>
                <filter string="SdP Transferencias Internas"
                    name="internals"
                    domain="[('state','=','internal_transfer')]"/>
                <filter string="SdP en Revisión o Aprobación"
                    name="others"
                    domain="[('state','!=','draft'), ('state','!=','sent'), ('state','!=','cancel'),('state','!=','internal_transfer'),
                            ('state','!=','descarted'),('state','!=','done'), ('state','!=','purchase')]"/>

                <filter string="Confirmation Date Last Year" name="later_than_a_year_ago" domain="[('date_approve', '&gt;=', ((context_today()-relativedelta(years=1)).strftime('%Y-%m-%d')))]"/>
                <filter name="filter_date_order" date="date_order"/>
                <filter name="filter_date_approve" date="date_approve" default_period="this_month"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                
                <group expand="0" string="Extended Filters">
                    <field name="user_id"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="date_order"/>
                    <field name="date_approve"/>
                    <field name="category_id" filter_domain="[('category_id', 'child_of', self)]"/>
                </group>
                <group expand="1" string="Group By">
                    <filter string="Vendor" name="group_partner_id" context="{'group_by':'partner_id'}"/>
                    <filter string="Vendor Country" name="country_id" context="{'group_by':'country_id'}"/>
                    <filter string="Purchase Representative" name="user_id" context="{'group_by':'user_id'}"/>
                    <filter string="Product" name="group_product_id" context="{'group_by':'product_id'}"/>
                    <filter string="Product Category" name="group_category_id" context="{'group_by':'category_id'}"/>
                    <filter string="Company" name="company" context="{'group_by':'company_id'}" groups="base.group_multi_company"/>
                    <separator/>
                    <filter string="Order Date" name="order_month" context="{'group_by': 'date_order:month'}"/>
                    <filter string="Confirmation Date" name="group_date_approve_month" context="{'group_by': 'date_approve:month'}"/>
                    <separator/>
                    <filter string="Cuenta Analítica" name="group_analytic_account" context="{'group_by':'analytic_account_id'}"/>
                    <filter string="Vehículo" name="group_vehicle_id" context="{'group_by':'vehicle_id'}"/>
                    <filter string="Fase" name="group_phase_id" context="{'group_by':'phase_id'}"/>
                </group>
            </search>
        </field>
    </record>

    </data>
</odoo>