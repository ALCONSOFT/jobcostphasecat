<odoo>
    <template id="report_purchase_request_document">
        <t t-call="web.external_layout">
            <main>
                <div class="page">
                    <div>
                        <h1>Purchase Request: <span t-esc="docs.name"/></h1>
                    </div>
                    <div>
                        <table class="table table-sm">
                            <tr>
                                <td><strong>Employee:</strong></td>
                                <td t-esc="docs.employee_id.display_name"/>
                            </tr>
                            <tr>
                                <td><strong>Department:</strong></td>
                                <td t-esc="docs.department_id.display_name"/>
                            </tr>
                            <tr>
                                <td><strong>Responsible:</strong></td>
                                <td t-esc="docs.request_responsible.display_name"/>
                            </tr>
                            <tr>
                                <td><strong>Warehouse:</strong></td>
                                <td t-esc="docs.warehouse_id.name"/>
                            </tr>
                            <tr>
                                <td><strong>Request Date:</strong></td>
                                <td t-esc="docs.request_date"/>
                            </tr>
                            <tr>
                                <td><strong>Company:</strong></td>
                                <td t-esc="docs.company_id.name"/>
                            </tr>
                            <tr>
                                <td><strong>Priority:</strong></td>
                                <td t-esc="docs.priority"/>
                            </tr>
                        </table>
                    </div>
                    <div>
                        <h2>Request Lines</h2>
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Vendors</th>
                                    <th>Quantity</th>
                                    <th>UoM</th>
                                    <th>Analytic Account</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="docs.pr_lines" t-as="line">
                                    <tr>
                                        <td t-esc="line.product_id.product_tmpl_id.display_name"/>
                                        <td>
                                            <ul>
                                                <t t-foreach="line.vendor_ids" t-as="vendor">
                                                    <li t-esc="vendor.display_name"/>
                                                </t>
                                            </ul>
                                        </td>
                                        <td t-esc="line.product_qty"/>
                                        <td t-esc="line.product_uom.name"/>
                                        <td t-esc="line.account_analytic_id.name"/>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                    <div>
                        <h2>Reason for Request</h2>
                        <p t-esc="docs.description"/>
                    </div>
                </div>
            </main>
        </t>
    </template>

    <template id="report_purchase_request">
        <t t-call="web.html_container">
            <t t-foreach="docss" t-as="docs">
                <t t-call="jobcostphasecat.report_purchase_request_document"/>
            </t>
        </t>
    </template>
</odoo>
