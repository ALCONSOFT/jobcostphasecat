<odoo>
    <template id="report_purchase_request_document">
        <t t-call="web.external_layout">
            <main>
                <div class="page">
                    <div>
                        <table class="table table-sm" style="width: 100%; text-align: right;">
                            <tr>
                                <td style="text-align: left;">
                                    <h1>Solicitud de Compra: <span t-esc="docs.name"/></h1>
                                </td>
                                <td>
                                    <p>F-COM-01</p>
                                    <p>Versión 03</p>
                                    <p>02/01/2025</p>
                                </td>
                            </tr>
                        </table>
                    </div>
                    <div>
                        <table class="table table-sm">
                            <tr>
                                <td><strong>Empleado:</strong></td>
                                <td t-esc="docs.employee_id.display_name"/>
                            </tr>
                            <tr>
                                <td><strong>Departamento:</strong></td>
                                <td t-esc="docs.department_id.display_name"/>
                            </tr>
                            <tr>
                                <td><strong>Responsable:</strong></td>
                                <td t-esc="docs.request_responsible.display_name"/>
                            </tr>
                            <tr>
                                <td><strong>Almacén:</strong></td>
                                <td t-esc="docs.warehouse_id.name"/>
                            </tr>
                            <tr>
                                <td><strong>Fecha de Solicitud:</strong></td>
                                <td t-esc="docs.request_date"/>
                            </tr>
                            <tr>
                                <td><strong>Empresa:</strong></td>
                                <td t-esc="docs.company_id.name"/>
                            </tr>
                            <tr>
                                <td><strong>Prioridad:</strong></td>
                                <td t-esc="docs.priority"/>
                            </tr>
                        </table>
                    </div>
                    <div>
                        <h2>Líneas de Solicitud</h2>
                        <table class="table table-bordered" style="font-size: smaller;">
                            <thead>
                                <tr>
                                    <th>Producto</th>
                                    <th>Proveedores</th>
                                    <th>Cantidad</th>
                                    <th>Unidad de Medida</th>
                                    <th>Cuenta Analítica</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="docs.pr_lines" t-as="line">
                                    <tr>
                                        <td t-esc="line.product_id.product_tmpl_id.display_name"/>
                                        <td>
                                            <ul>
                                                <t t-foreach="line.vendor_ids" t-as="vendor">
                                                    <li t-esc="vendor.display_name"/>
                                                </t>
                                            </ul>
                                        </td>
                                        <td t-esc="line.product_qty"/>
                                        <td t-esc="line.product_uom.name"/>
                                        <td t-esc="line.account_analytic_id.name"/>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                    <div>
                        <h3>Motivo de la Solicitud</h3>
                        <p t-esc="docs.description"/>
                    </div>
                </div>
            </main>
        </t>
    </template>

    <template id="report_purchase_request">
        <t t-call="web.html_container">
            <t t-foreach="docss" t-as="docs">
                <t t-call="jobcostphasecat.report_purchase_request_document"/>
            </t>
        </t>
    </template>
</odoo>
