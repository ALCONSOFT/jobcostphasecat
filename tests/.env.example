# Configuración para pruebas E2E
# Copiar este archivo a .env y llenar con los datos reales

# URL de tu instancia de Odoo
ODOO_URL=http://localhost:8069

# Base de datos de pruebas
ODOO_DATABASE=tu_base_de_datos

# Credenciales de usuario
ODOO_USERNAME=admin
ODOO_PASSWORD=admin

# Opciones adicionales para Selenium
BROWSER_HEADLESS=false
BROWSER_TIMEOUT=30