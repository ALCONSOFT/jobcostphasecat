<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
      <template id="email_template_purchase_order_body_custom" name="Correo QWeb: Orden de Compra Personalizado">
        <div style="margin: 0; padding: 20px; font-family: Arial, sans-serif; background-color: #f4f9fc; color: #003366; font-size: 14px;">
          <div style="max-width: 600px; margin: auto; background-color: #ffffff; border-radius: 8px; padding: 20px; box-shadow: 0 0 10px rgba(0, 51, 102, 0.1); border: 1px solid #d0e5f7;">
            

<div style="text-align: center;">
  <h2 style="background-color: #005b99;
     color: white;
     padding: 12px 20px;
     border-radius: 6px;
     text-transform: uppercase;
     font-size: 16px;
     letter-spacing: 1px;
     display: inline-block;">
    Confirmación de Orden de Compra
  </h2>
</div>

<table style="width: 100%; border-collapse: collapse; font-size: 14px; color: #003366; margin-top: 20px;">
  <tbody>
    <!-- Apreciados -->
    <tr>
      <td style="padding: 8px; vertical-align: top; font-weight: bold; width: 45%;">Apreciados:</td>
      <td style="padding: 8px;">
        <strong><t t-out="object.partner_id.name or ''"/></strong>
        <t t-if="object.partner_id.parent_id">
          (<strong><t t-out="object.partner_id.parent_id.name or ''"/></strong>)
        </t>
      </td>
    </tr>

    <!-- Adjuntamos la orden de compra -->
    <tr>
      <td style="padding: 8px; vertical-align: top; font-weight: bold;">Adjuntamos la Orden de Compra:</td>
      <td style="padding: 8px;">
        <strong style="color: #003366;"><t t-out="object.name or ''"/></strong>
        <t t-if="object.partner_ref">
          con referencia: <strong style="color: #003366;"><t t-out="object.partner_ref or ''"/></strong>
        </t>
        de <strong><t t-out="object.company_id.name or ''"/></strong>.
      </td>
    </tr>

    <!-- Monto total -->
    <tr>
      <td style="padding: 8px; vertical-align: top; font-weight: bold;">Monto total:</td>
      <td style="padding: 8px;">
        <strong style="font-size: 16px; color: #0073e6;"><t t-out="object.amount_total"/> <t t-out="object.currency_id.name"/></strong>
      </td>
    </tr>

    <!-- Fecha esperada -->
    <t t-if="object.date_planned">
      <tr>
        <td style="padding: 8px; vertical-align: top; font-weight: bold;">Esperamos recibir el pedido el:</td>
        <td style="padding: 8px;">
          <strong style="color: #005b99;"><t t-out="object.date_planned.strftime('%d de %B de %Y')"/></strong>
        </td>
      </tr>
    </t>
  </tbody>
</table>
<hr style="border: none; border-top: 1px solid #d0e5f7; margin: 30px 0;"/>
            <!--DESTINATARIOS-->
            <t t-if="object.message_follower_ids">
                <p style="margin-bottom: 15px; font-weight: bold; text-align: left; margin-left: 8px; color: #003366;"><strong>Este correo ha sido enviado a:</strong></p>
              <table style="width: 100%; border-collapse: collapse; font-size: 14px; color: #003366;">
                <thead>
                  <tr style="background-color: #e6f2ff; text-align: left;">
                    <th style="padding: 8px; border: 1px solid #d0e5f7; background-color: #005b99; color: white; font-weight: bold;">Nombre</th>
                    <th style="padding: 8px; border: 1px solid #d0e5f7; background-color: #005b99; color: white; font-weight: bold;">Correo Electrónico</th>
                  </tr>
                </thead>
                <tbody>
                  <t t-foreach="object.message_follower_ids" t-as="follower">
                    <tr>
                      <td style="padding: 8px; border: 1px solid #d0e5f7;">
                        <t t-out="follower.partner_id.name or ''"/>
                      </td>
                      <td style="padding: 8px; border: 1px solid #d0e5f7;">
                        <t t-if="follower.partner_id.email">
                          <t t-out="follower.partner_id.email"/>
                        </t>
                        <t t-else="true">
                          <em>(sin correo electrónico)</em>
                        </t>
                      </td>
                    </tr>
                  </t>
                </tbody>
              </table>
            </t>
            <!--Remitente o Firma-->
            <t t-if="object.user_id">
              <div style="margin-top: 30px; border-top: 2px solid #d0e5f7; padding: 20px; background-color: #f8fbff; border-radius: 8px;">
              <table style="width: 100%;">
                <tr>
                <td style="vertical-align: top;">
                  <div style="font-weight: bold; color: #005b99; margin-bottom: 5px;">
                  <t t-out="object.user_id.name"/>
                  </div>
                  <div style="color: #666; font-size: 13px;">
                  <t t-if="object.user_id.job_title" t-out="object.user_id.job_title"/><br/>
                  <t t-out="object.company_id.name"/>
                  </div>
                </td>
                </tr>
                <t t-if="object.user_id.signature">
                <tr>
                  <td style="padding-top: 10px;">
                  <div style="color: #444; font-size: 13px;">
                    <t t-raw="object.user_id.signature"/>
                  </div>
                  </td>
                </tr>
                </t>
              </table>
              </div>
            </t>

            <!-- Botón para abrir la orden de compra -->
            <div style="text-align: center; margin-top: 30px;">
              <a t-att-href="'/web#id=%s&amp;model=purchase.order&amp;view_type=form' % object.id" style="display: inline-block; padding: 12px 24px; background-color: #28a745; color: white; text-decoration: none; border-radius: 5px; font-weight: bold;">
                Ver Orden de Compra
              </a>
            </div>
<!-- Detalle de productos de la orden - OCULTO (2025-11-09) -->
<!-- Se oculta el detalle de productos para mostrar solo totales en el correo -->
